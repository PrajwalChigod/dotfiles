theme = Catppuccin Mocha
font-family = "IoskeleyMono Nerd Font"
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 14
background = "14141E"
copy-on-select = true
# keybind = shift+enter=text:\n

# macos specific settings
macos-option-as-alt = true

# Snap window resizes to whole terminal cells so there's no leftover
# fractional-row gap at the bottom of the window
window-step-resize = true

keybind = super+shift+f=toggle_fullscreen

# Better text rendering
font-thicken = true
adjust-cell-height = 10%

# Cursor settings
cursor-style = block
cursor-style-blink = true
cursor-opacity = 1

# Cursor Shaders - Neovide-style animations
# From: https://github.com/KroneCorylus/ghostty-shader-playground
# Restart Ghostty after changing.

custom-shader = shaders/cursor_smear.glsl
# custom-shader = shaders/cursor_smear_fade.glsl

# To disable shaders: comment out all custom-shader lines

